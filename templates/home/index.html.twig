<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CineHub - Movie Booking</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
        }

        .hero {
            background: #1f2937;
            color: white;
            padding: 70px 50px;
        }

        .hero h1 {
            font-size: 46px;
            margin: 0 0 15px;
        }

        .hero p {
            font-size: 20px;
            color: #d1d5db;
            max-width: 600px;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .section-title {
            font-size: 30px;
            margin-bottom: 25px;
        }

        .movies {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .movie-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        .poster {
            height: 300px;
            background: #d1d5db;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #555;
        }

        .movie-info {
            padding: 20px;
        }

        .movie-info h3 {
            margin-top: 0;
            font-size: 22px;
        }

        .movie-meta {
            color: #666;
            margin-bottom: 15px;
        }

        .book-button {
            display: inline-block;
            background: #111827;
            color: white;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
        }

        .book-button:hover {
            background: #374151;
        }

        @media (max-width: 768px) {
            .movies {
                grid-template-columns: 1fr;
            }

            .navbar {
                padding: 18px 20px;
            }

            .hero {
                padding: 50px 20px;
            }

            .hero h1 {
                font-size: 36px;
            }
        }
    </style>
</head>

<body>

<nav class="navbar">
    <div class="logo">🎬 CineHub</div>

    <div class="nav-links">
        <a href="{{ path('home') }}">Movies</a>
        {% if app.user %}
            <a href="{{ path('my_bookings') }}">My Bookings</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}">Login</a>
            <a href="{{ path('app_register') }}">Register</a>
        {% endif %}
    </div>
</nav>

<section class="hero">
    <h1>Book Your Movie Experience</h1>

    <p>
        Discover movies, choose your showtime,
        select your seats and book your tickets with CineHub.
    </p>
</section>

<main class="container">

    <h2 class="section-title">Now Showing</h2>

    <div class="movies">

        {% for movie in movies %}

            <div class="movie-card">

                <div class="poster">
                    🎬
                </div>

                <div class="movie-info">

                    <h3>{{ movie.title }}</h3>

                    <div class="movie-meta">
                        {{ movie.genre }}
                        ·
                        {{ movie.durationMinutes }} min
                        ·
                        {{ movie.language }}
                    </div>

                    <p>
                        {{ movie.description }}
                    </p>

                    <a
                        href="{{ path('movie_details', {id: movie.id}) }}"
                        class="book-button"
                    >
                        Book Now
                    </a>

                </div>

            </div>

        {% else %}

            <p>No movies available.</p>

        {% endfor %}

    </div>

</main>

</body>
</html>