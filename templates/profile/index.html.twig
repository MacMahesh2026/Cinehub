<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile - CineHub</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .container h1 {
            margin-bottom: 25px;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            align-items: start;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .card h2 {
            margin-top: 0;
            font-size: 20px;
        }

        .profile-name {
            font-size: 22px;
            font-weight: bold;
            margin: 0 0 4px;
        }

        .profile-email {
            color: #666;
            margin: 0 0 20px;
        }

        .profile-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-top: 1px solid #e5e7eb;
            color: #555;
        }

        .profile-row strong {
            color: #222;
        }

        .profile-link {
            display: inline-block;
            margin-top: 20px;
            background: #111827;
            color: white;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
        }

        .profile-link:hover {
            background: #374151;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 16px;
            font-family: Arial, sans-serif;
        }

        .form-control:focus {
            outline: none;
            border-color: #111827;
        }

        .form-help {
            color: #6b7280;
            font-size: 13px;
            margin: 6px 0 0;
        }

        .btn {
            width: 100%;
            background: #111827;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
            font-family: Arial, sans-serif;
        }

        .btn:hover {
            background: #374151;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-error,
        .form-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .form-error {
            padding: 8px 12px;
            border-radius: 6px;
            margin-top: 8px;
            font-size: 14px;
        }

        .form-error ul {
            margin: 0;
            padding-left: 18px;
        }

        @media (max-width: 768px) {
            .navbar {
                padding: 18px 20px;
            }

            .profile-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<nav class="navbar">
    <strong>🎬 CineHub</strong>

    <div>
        <a href="{{ path('home') }}">Movies</a>
        <a href="{{ path('my_bookings') }}">My Bookings</a>
        <a href="{{ path('app_profile') }}">Profile</a>
        <a href="{{ path('app_logout') }}">Logout</a>
    </div>
</nav>

<main class="container">

    <h1>My Profile</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="profile-grid">

        <section class="card">
            <h2>Account details</h2>

            <p class="profile-name">{{ user.name }}</p>
            <p class="profile-email">{{ user.email }}</p>

            <div class="profile-row">
                <strong>Member since</strong>
                <span>{{ user.createdAt ? user.createdAt|date('d M Y') : '—' }}</span>
            </div>

            <div class="profile-row">
                <strong>Total bookings</strong>
                <span>{{ totalBookings }}</span>
            </div>

            <div class="profile-row">
                <strong>Confirmed</strong>
                <span>{{ confirmedBookings }}</span>
            </div>

            <div class="profile-row">
                <strong>Cancelled</strong>
                <span>{{ cancelledBookings }}</span>
            </div>

            <a class="profile-link" href="{{ path('my_bookings') }}">View my bookings</a>
        </section>

        <section class="card">
            <h2>Update profile</h2>

            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div class="form-group">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
                    {% if form.name.vars.errors|length %}
                        <div class="form-error">{{ form_errors(form.name) }}</div>
                    {% endif %}
                </div>

                <div class="form-group">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control'}}) }}
                    <p class="form-help">Leave blank to keep your current password.</p>
                    {% if form.plainPassword.first.vars.errors|length %}
                        <div class="form-error">{{ form_errors(form.plainPassword.first) }}</div>
                    {% endif %}
                </div>

                <div class="form-group">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control'}}) }}
                    {% if form.plainPassword.second.vars.errors|length %}
                        <div class="form-error">{{ form_errors(form.plainPassword.second) }}</div>
                    {% endif %}
                </div>

                {{ form_widget(form.save, {attr: {class: 'btn'}}) }}
            {{ form_end(form) }}
        </section>

    </div>

</main>

{% include 'partials/jwt_expiry_guard.html.twig' %}
{% include 'partials/site_footer.html.twig' %}

</body>
</html>
