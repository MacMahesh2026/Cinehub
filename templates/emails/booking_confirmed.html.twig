<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Booking confirmed</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,sans-serif;color:#222;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:30px 0;">
    <tr>
        <td align="center">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:10px;overflow:hidden;">
                <tr>
                    <td style="background:#111827;color:#ffffff;padding:24px 30px;font-size:22px;font-weight:bold;">
                        🎬 CineHub
                    </td>
                </tr>

                <tr>
                    <td style="padding:30px;">
                        <h1 style="margin:0 0 12px;font-size:22px;">Booking confirmed 🎉</h1>
                        <p style="margin:0 0 24px;color:#555;">
                            Hi {{ booking.user.name }}, your booking is confirmed. Here are the details.
                        </p>

                        <p style="margin:0 0 6px;color:#888;font-size:12px;text-transform:uppercase;letter-spacing:.5px;">
                            Booking reference
                        </p>
                        <p style="margin:0 0 24px;font-size:18px;font-weight:bold;">
                            {{ booking.bookingReference }}
                        </p>

                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:15px;">
                            <tr>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;color:#555;">Movie</td>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;text-align:right;font-weight:bold;">
                                    {{ booking.showtime.movie.title }}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;color:#555;">Theatre</td>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;text-align:right;">
                                    {{ booking.showtime.screen.theatre.name }}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;color:#555;">Screen</td>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;text-align:right;">
                                    {{ booking.showtime.screen.name }}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;color:#555;">Show time</td>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;text-align:right;">
                                    {{ booking.showtime.startTime|date('d M Y, h:i A') }}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;color:#555;">Seats</td>
                                <td style="padding:10px 0;border-top:1px solid #e5e7eb;text-align:right;">
                                    {% for bookingSeat in booking.bookingSeats %}{{ bookingSeat.seat.seatNumber }}{{ not loop.last ? ', ' }}{% endfor %}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:14px 0;border-top:2px solid #111827;font-weight:bold;">Total paid</td>
                                <td style="padding:14px 0;border-top:2px solid #111827;text-align:right;font-weight:bold;">
                                    ₹{{ booking.totalAmount }}
                                </td>
                            </tr>
                        </table>

                        <p style="margin:28px 0 0;color:#888;font-size:13px;">
                            Please arrive at least 15 minutes before showtime. You can view or cancel this booking from your account.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="background:#f9fafb;padding:18px 30px;color:#9ca3af;font-size:12px;text-align:center;">
                        CineHub · support@cinehub.example
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
