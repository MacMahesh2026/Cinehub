<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Booking Details - CineHub</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .details-card {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .details-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e5e7eb;
        }

        .details-header h1 {
            margin: 6px 0 8px;
            font-size: 30px;
        }

        .eyebrow {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .reference {
            margin: 0;
            color: #555;
        }

        .status {
            background: #e5e7eb;
            color: #374151;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            white-space: nowrap;
        }

        .status.confirmed {
            background: #dcfce7;
            color: #166534;
        }

        .status.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 30px;
            padding: 25px 0;
            border-bottom: 1px solid #e5e7eb;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .info-label {
            color: #6b7280;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .info-value {
            font-size: 16px;
            color: #222;
        }

        .seats-section {
            padding: 25px 0;
            border-bottom: 1px solid #e5e7eb;
        }

        .seats-section h2 {
            margin: 0 0 12px;
            font-size: 18px;
        }

        .seats {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .seat {
            display: inline-block;
            background: #e5e7eb;
            border-radius: 5px;
            padding: 8px 14px;
            font-weight: bold;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 0;
        }

        .total-row span:first-child {
            color: #6b7280;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
        }

        .total {
            font-size: 26px;
            font-weight: bold;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 15px;
        }

        .actions form {
            margin: 0;
        }

        .btn {
            display: inline-block;
            border: none;
            border-radius: 6px;
            padding: 11px 20px;
            font-size: 15px;
            font-family: inherit;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-secondary {
            background: #111827;
            color: white;
        }

        .btn-danger {
            background: #fee2e2;
            color: #991b1b;
            font-weight: bold;
        }

        .btn-danger:hover {
            background: #fecaca;
        }

        .cancelled-note {
            margin: 0;
            padding: 14px 18px;
            background: #fee2e2;
            color: #991b1b;
            border-radius: 6px;
        }

        @media (max-width: 600px) {
            .navbar {
                padding: 18px 20px;
            }

            .details-header {
                flex-direction: column;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .actions {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }
        }
    </style>
</head>

<body>

<nav class="navbar">
    <strong>🎬 CineHub</strong>

    <div>
        <a href="{{ path('home') }}">Movies</a>
        <a href="{{ path('my_bookings') }}">My Bookings</a>
        <a href="{{ path('app_logout') }}">Logout</a>
    </div>
</nav>

<main class="container">

    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <section class="details-card">

        <div class="details-header">

            <div>
                <p class="eyebrow">Booking Details</p>

                <h1>
                    {{ booking.showtime.movie.title }}
                </h1>

                <p class="reference">
                    Booking Reference:
                    <strong>{{ booking.bookingReference }}</strong>
                </p>
            </div>

            <span class="status {{ booking.status|lower }}">
                {{ booking.status }}
            </span>

        </div>

        <div class="info-grid">

            <div class="info-item">
                <span class="info-label">Theatre</span>
                <span class="info-value">
                    {{ booking.showtime.screen.theatre.name }}
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Screen</span>
                <span class="info-value">
                    {{ booking.showtime.screen.name }}
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Show Time</span>
                <span class="info-value">
                    {{ booking.showtime.startTime|date('d M Y, h:i A') }}
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Booked On</span>
                <span class="info-value">
                    {% if booking.bookingDate %}
                        {{ booking.bookingDate|date('d M Y, h:i A') }}
                    {% else %}
                        —
                    {% endif %}
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">Price per Seat</span>
                <span class="info-value">
                    ₹{{ booking.showtime.price }}
                </span>
            </div>

        </div>

        <div class="seats-section">

            <h2>Seats</h2>

            <div class="seats">
                {% for bookingSeat in booking.bookingSeats %}
                    <span class="seat">
                        {{ bookingSeat.seat.seatNumber }}
                    </span>
                {% endfor %}
            </div>

        </div>

        <div class="total-row">
            <span>Total Amount</span>
            <span class="total">₹{{ booking.totalAmount }}</span>
        </div>

        <div class="actions">

            {% if booking.status == 'CONFIRMED' %}

                <form
                    method="POST"
                    action="{{ path('booking_cancel', {id: booking.id}) }}"
                    onsubmit="return confirm('Cancel this booking?');"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ cancelToken }}"
                    >

                    <button type="submit" class="btn btn-danger">
                        Cancel Booking
                    </button>
                </form>

            {% else %}

                <p class="cancelled-note">
                    This booking has been cancelled.
                </p>

            {% endif %}

            <a href="{{ path('my_bookings') }}" class="btn btn-secondary">
                ← Back to My Bookings
            </a>

        </div>

    </section>

</main>

{% include 'partials/site_footer.html.twig' %}

</body>
</html>
