<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ movie.title }} - CineHub</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
        }

        .navbar a {
            color: white;
            text-decoration: none;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .movie-details {
            background: white;
            padding: 30px;
            border-radius: 10px;
            display: flex;
            gap: 30px;
            margin-bottom: 35px;
        }

        .poster {
            width: 250px;
            height: 350px;
            background: #d1d5db;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .movie-info h1 {
            margin-top: 0;
            font-size: 36px;
        }

        .description {
            color: #555;
            line-height: 1.6;
        }

        .showtimes {
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        .showtime {
            border: 1px solid #ddd;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .showtime h3 {
            margin-top: 0;
        }

        .showtime-info {
            color: #666;
            margin-bottom: 15px;
        }

        .select-button {
            display: inline-block;
            background: #111827;
            color: white;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
        }

        @media (max-width: 700px) {
            .movie-details {
                flex-direction: column;
            }

            .poster {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<nav class="navbar">
    <strong>🎬 CineHub</strong>

    <div>
        <a href="{{ path('home') }}">Movies</a>
        {% if app.user %}
            <a href="{{ path('my_bookings') }}">My Bookings</a>
            <a href="{{ path('app_logout') }}">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}">Login</a>
            <a href="{{ path('app_register') }}">Register</a>
        {% endif %}
    </div>
</nav>

<main class="container">

    <section class="movie-details">

        <div class="poster">
            🎬 Movie Poster
        </div>

        <div class="movie-info">

            <h1>{{ movie.title }}</h1>

            <p>
                <strong>Genre:</strong>
                {{ movie.genre }}
            </p>

            <p>
                <strong>Language:</strong>
                {{ movie.language }}
            </p>

            <p>
                <strong>Duration:</strong>
                {{ movie.durationMinutes }} minutes
            </p>

            <p class="description">
                {{ movie.description }}
            </p>

        </div>

    </section>


    <section class="showtimes">

        <h2>Available Showtimes</h2>

        {% for showtime in movie.showtimes %}

            <div class="showtime">

                <h3>
                    {{ showtime.screen.theatre.name }}
                </h3>

                <div class="showtime-info">

                    {{ showtime.screen.name }}

                    ·

                    {{ showtime.startTime|date('d M Y, h:i A') }}

                    ·

                    ₹{{ showtime.price }}

                </div>

                <a
                    href="{{ path('showtime_seats', {id: showtime.id}) }}"
                    class="select-button"
                >
                    Select Showtime
                </a>

            </div>

        {% else %}

            <p>No showtimes available for this movie.</p>

        {% endfor %}

    </section>

</main>

</body>
</html>