APP_ENV=dev
APP_SECRET=change-me-to-a-random-secret
DEFAULT_URI=http://127.0.0.1:8000

DATABASE_URL="mysql://app:change_me@127.0.0.1:3306/cinehub?serverVersion=8.4.0&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
###> movie posters (S3) ###
MOVIE_POSTER_URI_PREFIX=https://your-cloudfront-domain.example
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
###< movie posters (S3) ###

###> symfony/mailer ###
# No-op by default so nothing breaks before a provider is configured.
# In production set a real DSN in .env.local. Brevo (free plan) examples:
#   MAILER_DSN=brevo+api://API_KEY@default
#   MAILER_DSN=brevo+smtp://USERNAME:SMTP_KEY@smtp-relay.brevo.com:587
# See docs/deployment.md for the full checklist.
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> notifications (Brevo email + WhatsApp Cloud API) ###
# Must be an address (or domain) verified in Brevo, otherwise the provider
# rejects the message. Example: bookings@your-domain.example
MAILER_FROM=bookings@your-domain.example
# WhatsApp is optional. Leave these empty to keep WhatsApp disabled; email
# continues to work because the app has safe empty fallbacks.
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=booking_confirmation
WHATSAPP_TEMPLATE_LANG=en
# Override the Graph API host to test locally against a mock, e.g.
# WHATSAPP_BASE_URI=http://127.0.0.1:8090
# WHATSAPP_BASE_URI=https://graph.facebook.com
###< notifications (Brevo email + WhatsApp Cloud API) ###
